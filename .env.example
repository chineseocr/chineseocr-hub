# Compose reads .env. For a local Python run, export these values in your shell.
# Copy this file only when .env does not already exist; never commit private values.
# Local image tag and loopback-only host port (container port remains 8765).
WORKBENCH_IMAGE_TAG=0.6.0a1
WORKBENCH_PORT=8765
# Optional: replace with a tested python:3.12-slim-bookworm@sha256:... digest.
WORKBENCH_PYTHON_IMAGE=python:3.12-slim-bookworm

# Leave empty to generate a private access token in data/access-token.
WORKBENCH_TOKEN=
# Local Python only; container storage uses /app/data.
WORKBENCH_DATA_DIR=data

# Optional: create/select a real model connection at startup.
# Configure your own endpoint; a bare host is normalized to /v1.
WORKBENCH_MODEL_BASE_URL=
WORKBENCH_MODEL_NAME=
WORKBENCH_MODEL_API_KEY=
# compatible: Qwen/vLLM max_tokens + temperature=0.
# openai: max_completion_tokens, omit temperature for modern OpenAI models.
WORKBENCH_MODEL_REQUEST_PROFILE=compatible
WORKBENCH_MODEL_LABEL=

# Optional compose.qwen.yaml only: choose a private model-service key.
QWEN_API_KEY=

# Choose community (one trusted workspace) or saas (accounts and isolated teams).
WORKBENCH_MODE=community
# SaaS defaults to invitation-only; enable public username registration explicitly.
WORKBENCH_ALLOW_REGISTRATION=0
# SaaS: comma-separated exact approved API bases; blank rejects all model targets.
# Operator MODEL_* profiles above are never inherited by tenant workspaces.
WORKBENCH_ALLOWED_MODEL_BASES=
